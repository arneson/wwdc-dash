# Required: Passkey to access the dashboard
# Set this in Netlify env vars, then visit: https://yoursite.netlify.app?key=YOUR_KEY
# A cookie is set so you only need the link once per browser.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_KEY=CHANGE_ME

# Optional: Enable X/Twitter + Meetup scraping via Google search
# Sign up at https://serper.dev (free, 2500 searches/month, no credit card)
# SERPER_API_KEY=your-serper-api-key
